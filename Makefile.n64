#
# Elite - The New Kind.
#
# Nintendo 64 Makefile using libdragon.
#
# Prerequisites:
#   - libdragon SDK installed (https://github.com/DragonMinded/libdragon)
#   - N64 toolchain in PATH (use libdragon's Docker container or native install)
#   - Set N64_INST environment variable to your libdragon installation path
#
# Build with Docker (recommended):
#   libdragon make -f Makefile.n64
#
# Build native:
#   make -f Makefile.n64
#
# Clean:
#   make -f Makefile.n64 clean
#

# Include libdragon build system first (provides N64 toolchain vars)
include $(N64_INST)/include/n64.mk

# ROM name
ROM_NAME = elite_newkind

# Source files for the N64 build.
SRCS = \
	n64_main.c \
	n64_gfx.c \
	n64_input.c \
	n64_sound.c \
	n64_file.c \
	n64_font.c \
	n64_spritedata.c \
	elite.c \
	docked.c \
	intro.c \
	missions.c \
	options.c \
	pilot.c \
	planet.c \
	random.c \
	shipdata.c \
	shipface.c \
	space.c \
	stars.c \
	swat.c \
	threed.c \
	trade.c \
	vector.c

OBJS = $(SRCS:%.c=%.o)

# N64 compile flags
CFLAGS += -DPLATFORM_N64 -I. -O2

# Filesystem directory for ROM assets
FS_DIR = filesystem

# WAV files to convert to wav64
WAV_FILES = launch.wav crash.wav dock.wav gameover.wav pulse.wav hitem.wav \
            explode.wav ecm.wav missile.wav hyper.wav incom1.wav incom2.wav \
            beep.wav boop.wav

WAV64_FILES = $(WAV_FILES:%.wav=$(FS_DIR)/%.wav64)

# Data files to include in ROM filesystem
FS_DATA = $(FS_DIR)/newkind.cfg $(FS_DIR)/newscan.cfg $(FS_DIR)/scanner.bmp

all: $(ROM_NAME).z64

$(FS_DIR):
	mkdir -p $(FS_DIR)

# Convert WAV files to wav64 format for libdragon
$(FS_DIR)/%.wav64: %.wav | $(FS_DIR)
	@echo "  [WAV64] $<"
	$(N64_INST)/bin/audioconv64 -o $@ $<

# Copy data files to filesystem staging
$(FS_DIR)/newkind.cfg: newkind.cfg | $(FS_DIR)
	cp $< $@

$(FS_DIR)/newscan.cfg: newscan.cfg | $(FS_DIR)
	cp $< $@

$(FS_DIR)/scanner.bmp: scanner.bmp | $(FS_DIR)
	cp $< $@

# Build the DFS filesystem image
$(ROM_NAME).dfs: $(WAV64_FILES) $(FS_DATA)
	$(N64_INST)/bin/mkdfs $@ $(FS_DIR)

# Compile C sources (n64.mk provides the rules)
%.o: %.c
	@echo "  [CC] $<"
	$(CC) -c $(CFLAGS) -o $@ $<

# Link
$(ROM_NAME).elf: $(OBJS)
	$(CC) -o $@ $^ $(LDFLAGS) -ldragon -lm -lc -ldragonsys

# Create ROM with DFS appended
$(ROM_NAME).z64: $(ROM_NAME).elf $(ROM_NAME).dfs
	$(N64_INST)/bin/n64tool \
		-l 4M \
		-h $(N64_INST)/mips64-elf/lib/header \
		-o $@ \
		-t "Elite - The New Kind" \
		$< \
		-s 1M $(ROM_NAME).dfs
	$(N64_INST)/bin/chksum64 $@
	@echo ""
	@echo "ROM built: $@ ($(shell stat -c%s $@ 2>/dev/null || echo '?') bytes)"

clean:
	rm -f $(OBJS) $(ROM_NAME).elf $(ROM_NAME).z64 $(ROM_NAME).dfs
	rm -rf $(FS_DIR)

.PHONY: all clean
