#
# Elite - The New Kind.
#
# Nintendo 64 Makefile using libdragon.
#
# Prerequisites:
#   - libdragon SDK installed (https://github.com/DragonMinded/libdragon)
#   - N64 toolchain (mips64-elf-gcc) in PATH
#   - audioconv64 tool for wav -> wav64 conversion
#
# Build:
#   make -f Makefile.n64
#
# Clean:
#   make -f Makefile.n64 clean
#

# ROM name
ROM_NAME = elite_newkind
BUILD_DIR = build_n64

# Source files for the N64 build.
# We use n64_gfx.c, n64_main.c, n64_input.c, n64_sound.c, n64_file.c
# instead of the Allegro-specific versions.
SRCS = \
	n64_main.c \
	n64_gfx.c \
	n64_input.c \
	n64_sound.c \
	n64_file.c \
	n64_font.c \
	elite.c \
	docked.c \
	intro.c \
	missions.c \
	options.c \
	pilot.c \
	planet.c \
	random.c \
	shipdata.c \
	shipface.c \
	space.c \
	stars.c \
	swat.c \
	threed.c \
	trade.c \
	vector.c

OBJS = $(SRCS:%.c=$(BUILD_DIR)/%.o)

# N64 compile flags
N64_CFLAGS = -DPLATFORM_N64 -I. -O2 -Wall

# Include libdragon build system
include $(N64_INST)/include/n64.mk

# Filesystem assets to pack into ROM
FS_DIR = $(BUILD_DIR)/filesystem

# WAV files to convert to wav64
WAV_FILES = launch.wav crash.wav dock.wav gameover.wav pulse.wav hitem.wav \
            explode.wav ecm.wav missile.wav hyper.wav incom1.wav incom2.wav \
            beep.wav boop.wav

WAV64_FILES = $(WAV_FILES:%.wav=$(FS_DIR)/%.wav64)

# Config and data files to include in ROM filesystem
FS_DATA_FILES = $(FS_DIR)/newkind.cfg $(FS_DIR)/newscan.cfg $(FS_DIR)/scanner.bmp $(FS_DIR)/elite.dat

all: $(ROM_NAME).z64

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(FS_DIR):
	mkdir -p $(FS_DIR)

# Compile C source files
$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	$(N64_CC) $(N64_CFLAGS) $(CFLAGS) -c $< -o $@

# Convert WAV files to wav64 format for libdragon
$(FS_DIR)/%.wav64: %.wav | $(FS_DIR)
	audioconv64 -o $@ $<

# Copy config/data files to filesystem
$(FS_DIR)/newkind.cfg: newkind.cfg | $(FS_DIR)
	cp $< $@

$(FS_DIR)/newscan.cfg: newscan.cfg | $(FS_DIR)
	cp $< $@

$(FS_DIR)/scanner.bmp: scanner.bmp | $(FS_DIR)
	cp $< $@

$(FS_DIR)/elite.dat: elite.dat | $(FS_DIR)
	cp $< $@

# Build the DFS (DragonFS) filesystem image
$(BUILD_DIR)/$(ROM_NAME).dfs: $(WAV64_FILES) $(FS_DATA_FILES)
	mkdfs $@ $(FS_DIR)

# Link the ELF
$(BUILD_DIR)/$(ROM_NAME).elf: $(OBJS)
	$(N64_CC) $(N64_LDFLAGS) -o $@ $^ $(N64_LIBS) -ldragon -lm -lc -ldragonsys

# Convert ELF to raw binary
$(BUILD_DIR)/$(ROM_NAME).bin: $(BUILD_DIR)/$(ROM_NAME).elf
	$(N64_OBJCOPY) -O binary $< $@

# Build final ROM with filesystem appended
$(ROM_NAME).z64: $(BUILD_DIR)/$(ROM_NAME).bin $(BUILD_DIR)/$(ROM_NAME).dfs
	@# Create ROM header + code
	n64tool -l 4M \
		-h $(N64_INST)/mips64-elf/lib/header \
		-o $@ \
		-t "Elite - The New Kind" \
		$(BUILD_DIR)/$(ROM_NAME).bin \
		-s 1M $(BUILD_DIR)/$(ROM_NAME).dfs
	@# Fix ROM checksum
	chksum64 $@

clean:
	rm -rf $(BUILD_DIR) $(ROM_NAME).z64

.PHONY: all clean
